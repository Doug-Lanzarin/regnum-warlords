{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"types": ["@cloudflare/workers-types"],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"resolveJsonModule": true
	},
	"include": ["src", "../src/data/realms.ts", "../src/data/bossConstants.ts", "../src/data/fortKind.ts", "../src/features/wz/wzEngine.ts", "../src/types/alertSettings.ts", "../src/types/wz.ts", "../src/types/bosses.ts"]
}
